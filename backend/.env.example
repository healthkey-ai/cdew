# Copy to .env for local dev. Never commit real secrets or PHI.
SECRET_KEY=dev-secret-change-me
DEBUG=True
DATABASE_URL=postgres://cdew:dev_only_change_in_prod@localhost:5432/cdew
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (design §10). Dev uses the Generative Language API (API key).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_BACKEND=gla
GEMINI_API_KEY=

# Or Claude via the Anthropic API (the hk-labs / Render staging setup — no GCP).
# Current Claude models ignore LLM_TEMPERATURE / LLM_SEED (unsupported); depth is
# set with LLM_EFFORT (low|medium|high|xhigh|max, empty = API default).
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# LLM_EFFORT=
# LLM_MAX_TOKENS=16000

# Staging/prod use Vertex AI (BAA) via ADC — set instead of GEMINI_API_KEY:
# GEMINI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=us-central1

# Document AI — geometry OCR (token bboxes + page images) for the review overlay
# (design §9, #66). BAA via ADC (roles/documentai.apiUser). Off unless enabled.
# DOCAI_ENABLED=True
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=

# Object storage (leave empty for local filesystem in dev).
# GS_BUCKET_NAME=
# Local-filesystem root when no bucket is set (Render staging: the persistent disk).
# MEDIA_ROOT=/var/data/media
# AWS_STORAGE_BUCKET_NAME=

# Pipeline (design §3). Off by default: uploads are parsed and then wait in the
# human-classification queue. Set True to auto-classify → extract on upload.
# PIPELINE_AUTO_CLASSIFY=False

# Orchestration (Prefect, design §6). Default `local` runs the pipeline
# synchronously in the API process — no Prefect needed. To run on the local
# engine, `make prefect-server` + `make prefect-worker` (see README), then:
# PREFECT_DISPATCH=deployment
# PREFECT_API_URL=http://127.0.0.1:4200/api
# PREFECT_DEPLOYMENT=extract-document/default
# PREFECT_DRYRUN_DEPLOYMENT=dry-run/default   # async Test Set dry-run (#55)
# PREFECT_GEMINI_CONCURRENCY=8
# Zero-infra async alternative (no server/UI): PREFECT_DISPATCH=thread

# Staff sign-in via promop, phr or an org's Firebase (design §11, #31). Off by
# default → only CDEW-local accounts. Partner sign-ins arrive with NO role; an
# admin grants one on the Users screen (role-less accounts see "Awaiting access").
# PARTNER_AUTH_PROVIDERS=apps.accounts.providers.jwks.JwksTokenProvider,apps.accounts.providers.firebase.FirebaseTokenProvider
# Trusted JWKS issuers (JSON). `login_url` adds a sign-in option on the login page;
# `audience` (optional) is enforced when set. No introspection URLs.
# PARTNER_AUTH_ISSUERS=[{"key":"promop","label":"HealthKey (PROMOP)","issuer":"https://promop-staging.onrender.com","jwks_url":"https://promop-staging.onrender.com/api/v1/family/auth/jwks/","login_url":"https://promop-staging.onrender.com/api/v1/family/auth/login/"},{"key":"phr","label":"PHR","issuer":"https://phr.example.org","jwks_url":"https://phr.example.org/api/v1/auth/jwks/","login_url":"https://phr.example.org/api/v1/auth/login/"}]
# Org-owned Firebase: the public web config drives "Continue with Google".
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_CONFIG={"apiKey":"…","authDomain":"….firebaseapp.com","projectId":"…"}
# FIREBASE_CREDENTIALS_JSON=          # service account; else ADC (or FIREBASE_AUTH_EMULATOR_HOST)
# FIREBASE_SKIP_REVOCATION_CHECK=False
# AUTH_THROTTLE_RATE=30/min           # per-client limit on the sign-in endpoints
