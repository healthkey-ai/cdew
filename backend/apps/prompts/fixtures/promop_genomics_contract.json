{
 "_comment": "Reviewed, pinned receiving contract for genomic_variant (workstream G, cdew#101; docs/genomics-integration.md). promop does not publish its genomics action in OpenAPI, and OpenAPI omission is not permission — so the 29 accepted payload keys are captured from promop's own catalog and writer, and changed only by review. Catalog availability is not write readiness: committing is held until promop#1245.",
 "source": {
  "repo": "healthkey-ai/promop",
  "commit": "30d561cf",
  "files": ["omop_core/data/genomics_catalog_v1.json", "omop_core/services/genomics.py (normalize_variant)"],
  "reviewed": "2026-11-10",
  "annotations": "`format: date` is CDEW's (promop stores these dates as strings); `enum` values are from normalize_variant's validation."
 },
 "endpoint": "/api/v1/patient-records/{person_id}/genomics/",
 "required": ["gene"],
 "fields": {
  "gene": {"value_kind": "string", "table": "measurement"},
  "variant_name": {"value_kind": "string", "table": "observation"},
  "variant": {"value_kind": "string", "table": "measurement"},
  "variant_description": {"value_kind": "string", "table": "observation"},
  "genome_assembly": {"value_kind": "string", "table": "measurement"},
  "transcript_reference_sequence_id": {"value_kind": "string", "table": "measurement"},
  "genomic_reference_sequence_id": {"value_kind": "string", "table": "observation"},
  "genomic_dna_change": {"value_kind": "string", "table": "measurement"},
  "amino_acid_change": {"value_kind": "string", "table": "measurement"},
  "chromosome": {"value_kind": "string", "table": "measurement"},
  "cytogenetic_location": {"value_kind": "string", "table": "measurement"},
  "variant_category": {"value_kind": "string", "table": "measurement"},
  "zygosity": {"value_kind": "string", "table": "observation"},
  "origin": {"value_kind": "string", "table": "observation"},
  "genomic_source_class": {"value_kind": "string", "table": "measurement"},
  "assessment": {"value_kind": "string", "table": "observation",
                 "enum": ["present", "absent", "not_tested", "no_call", "indeterminate"]},
  "allelic_frequency": {"value_kind": "number", "table": "measurement"},
  "allelic_frequency_unit": {"value_kind": "string", "table": "measurement", "enum": ["%", "1"]},
  "interpretation": {"value_kind": "string", "table": "measurement"},
  "classification_framework": {"value_kind": "string", "table": "observation"},
  "interpretation_date": {"value_kind": "string", "format": "date", "table": "observation"},
  "evidence_source": {"value_kind": "string", "table": "observation"},
  "test_date": {"value_kind": "string", "format": "date", "table": "measurement"},
  "variant_analysis_method_type": {"value_kind": "string", "table": "measurement"},
  "specimen_id": {"value_kind": "string", "table": "observation"},
  "specimen_type": {"value_kind": "string", "table": "observation"},
  "collection_date": {"value_kind": "string", "format": "date", "table": "observation"},
  "report_id": {"value_kind": "string", "table": "observation"},
  "laboratory": {"value_kind": "string", "table": "observation"}
 }
}
